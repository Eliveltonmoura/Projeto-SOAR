# Banco de Dados (uso local)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=sua_senha_aqui
DB_DATABASE=soar_db

# Em produção (ex: Render), defina DATABASE_URL com a connection string
# do Postgres — substitui as variáveis DB_* acima e habilita SSL.
# DATABASE_URL=postgres://usuario:senha@host:5432/banco

# Em produção, defina DB_SYNCHRONIZE=true apenas no primeiro deploy
# (cria as tabelas automaticamente). Depois disso, remova ou defina como
# false e use migrations.
# DB_SYNCHRONIZE=true

# Aplicação
PORT=3000
NODE_ENV=development

# URL do frontend implantado (libera o CORS para essa origem)
FRONTEND_URL=http://localhost:5173

# Segurança
BCRYPT_ROUNDS=10

# Autenticação
JWT_SECRET=troque_por_um_segredo_forte
JWT_EXPIRES_IN=8h
ADMIN_NOME=Administrador SOAR
ADMIN_EMAIL=admin@soar.org
ADMIN_PASSWORD=defina_uma_senha_forte
